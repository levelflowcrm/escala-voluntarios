# Copie para .env.local e preencha com os dados do projeto no Supabase
# (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon

# Avisos por WhatsApp (Uazapi) — só no servidor (Vercel → Settings → Environment Variables)
UAZAPI_URL=https://SEU-SERVIDOR.uazapi.com
UAZAPI_TOKEN=token-da-instancia
WHATSAPP_ATIVO=false            # interruptor geral: só "true" envia
SUPABASE_SERVICE_ROLE_KEY=chave-service-role   # Project Settings → API (nunca expor no navegador)
CRON_SECRET=um-segredo-longo-aleatorio         # o Vercel Cron envia como "Bearer"
